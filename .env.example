# ZephyrTV branding
NEXT_PUBLIC_SITE_NAME=ZephyrTV

# Primary storage: localstorage, redis, upstash, kvrocks, or sqlite
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# Personal data storage: remote uses the primary backend; local keeps personal
# playback, favorites, reminders, search history, skip settings, and derived
# user statistics in this browser only.
NEXT_PUBLIC_USER_DATA_STORAGE=remote

# Disable server-side playback and login statistics to reduce backend commands.
DISABLE_STATS=false

# Local owner credentials. Replace before deployment.
USERNAME=admin
PASSWORD=change-me
